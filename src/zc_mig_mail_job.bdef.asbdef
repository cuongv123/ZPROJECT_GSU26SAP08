projection;
strict ( 2 );

define behavior for ZC_MIG_MAIL_JOB alias MailJob
use etag
{
  use create;
  use update;
  use delete;

  use action sendNow;

  use association _Recipients { create; }
}

define behavior for ZC_MIG_MAIL_RECIP alias Recipient
use etag
{
  use update;
  use delete;

  use association _Job;
}