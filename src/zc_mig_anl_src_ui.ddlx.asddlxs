@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName:       'Source Object',
  typeNamePlural: 'Source Objects',
  title: {
    type:  #STANDARD,
    value: 'ObjectName'
  },
  description: {
    value: 'ObjectType'
  }
}

annotate view ZC_MIG_ANL_SRC with
{
  @UI.hidden: true
  AnalysisId;

  @UI.hidden: true
  ItemId;

  @UI.lineItem: [
    {
      position:   10,
      importance: #HIGH,
      label:      'Source Object'
    }
  ]
  @UI.identification: [
    {
      position: 10,
      label:    'Source Object'
    }
  ]
  ObjectName;

  @UI.lineItem: [
    {
      position:   20,
      importance: #HIGH,
      label:      'Object Type'
    }
  ]
  @UI.identification: [
    {
      position: 20,
      label:    'Object Type'
    }
  ]
  ObjectType;

  @UI.lineItem: [
    {
      position:   30,
      importance: #MEDIUM,
      label:      'Parent Object'
    }
  ]
  @UI.identification: [
    {
      position: 30,
      label:    'Parent Object'
    }
  ]
  ParentObject;

  @UI.lineItem: [
    {
      position: 40,
      label:    'Depth'
    }
  ]
  @UI.identification: [
    {
      position: 40,
      label:    'Include Depth'
    }
  ]
  IncludeDepth;

  @UI.lineItem: [
    {
      position: 50,
      label:    'Lines'
    }
  ]
  @UI.identification: [
    {
      position: 50,
      label:    'Line Count'
    }
  ]
  LineCount;

  @UI.identification: [
    {
      position: 60,
      label:    'Source Hash'
    }
  ]
  SourceHash;
}