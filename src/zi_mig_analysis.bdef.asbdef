unmanaged implementation in class zbp_i_mig_analysis unique;
strict ( 2 );

define behavior for ZI_MIG_ANALYSIS alias Analysis
lock master
authorization master ( global )
{
  field ( readonly ) AnalysisId;

  static action Analyze
    parameter ZA_MIG_ANALYZE_PARAM
    result [1] $self;
  action GenerateOData
  parameter ZA_MIG_GEN_ODATA_PARAM
  result [1] ZA_MIG_GEN_ODATA_RESULT;

  // === MỚI: action export theo field được chọn (chức năng 4) ===
  action PrepareSelectedExport
    parameter ZA_MIG_PREPARE_EXPORT_PARAM
    result [1] ZA_MIG_PREPARE_EXPORT_RESULT;
  association _SourceObjects;
  association _UiFilters;
  association _DatabaseObjects;
  association _BusinessLogic;
  association _AlvOutputs;
  association _Evidences;
  association _Recommendations;
  association _Messages;
}

define behavior for ZI_MIG_ANL_SRC alias SourceObject
lock dependent by _Analysis
authorization dependent by _Analysis
{
  field ( readonly )
    AnalysisId,
    ItemId;

  association _Analysis;
}

