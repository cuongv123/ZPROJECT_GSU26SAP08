@Metadata.layer: #CORE

annotate view ZC_MIG_ANL_FLT with
{
  @UI.hidden: true
  AnalysisId;

  @UI.hidden: true
  OutputId;

  @UI.hidden: true
  ItemId;

  @UI.lineItem: [
    {
      position: 10,
      importance: #HIGH,
      label: 'Field'
    }
  ]
  FieldName;

  @UI.lineItem: [
    {
      position: 20,
      label: 'Sign'
    }
  ]
  FilterSign;

  @UI.lineItem: [
    {
      position: 30,
      label: 'Option'
    }
  ]
  FilterOption;

  @UI.lineItem: [
    {
      position: 40,
      label: 'Low Value'
    }
  ]
  LowValue;

  @UI.lineItem: [
    {
      position: 50,
      label: 'High Value'
    }
  ]
  HighValue;

  @UI.lineItem: [
    {
      position: 60,
      label: 'Confidence'
    }
  ]
  Confidence;
}