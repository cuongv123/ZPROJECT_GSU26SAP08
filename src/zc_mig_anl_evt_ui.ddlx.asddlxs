@Metadata.layer: #CORE

annotate view ZC_MIG_ANL_EVT with
{
  @UI.hidden: true
  AnalysisId;

  @UI.hidden: true
  OutputId;

  @UI.hidden: true
  ItemId;

  @UI.lineItem: [
    {
      position: 10,
      importance: #HIGH,
      label: 'Event'
    }
  ]
  EventName;

  @UI.lineItem: [
    {
      position: 20,
      importance: #HIGH,
      label: 'Handler'
    }
  ]
  HandlerName;

  @UI.lineItem: [
    {
      position: 30,
      label: 'Handler Kind'
    }
  ]
  HandlerKind;

  @UI.lineItem: [
    {
      position: 40,
      label: 'Control Object'
    }
  ]
  ControlObject;

  @UI.lineItem: [
    {
      position: 50,
      label: 'GUI Dependency'
    }
  ]
  GuiDependency;

  @UI.lineItem: [
    {
      position: 60,
      label: 'Confidence'
    }
  ]
  Confidence;
}