@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName:       'Source Line',
  typeNamePlural: 'Source Lines',
  title: {
    type:  #STANDARD,
    value: 'LineNumber'
  }
}

@UI.presentationVariant: [{
  sortOrder: [{
    by:        'LineNumber',
    direction: #ASC
  }],
  visualizations: [{
    type: #AS_LINEITEM
  }]
}]

annotate view ZC_MIG_ANL_CODE with
{
  @UI.hidden: true
  AnalysisId;

  @UI.hidden: true
  SourceItemId;

  @UI.lineItem: [{
    position:   10,
    importance: #HIGH,
    label:      'Line'
  }]
  LineNumber;

  @UI.multiLineText: true
  @UI.lineItem: [{
    position:   20,
    importance: #HIGH,
    label:      'Source Code'
  }]
  @UI.identification: [{
    position: 10,
    label:    'Source Code'
  }]
  SourceText;
}