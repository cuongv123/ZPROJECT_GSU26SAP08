@Metadata.layer: #CORE

annotate view ZC_MIG_ANL_DB with
{
  @UI.hidden: true
  AnalysisId;

  @UI.hidden: true
  ItemId;

  @UI.lineItem: [
    {
      position: 10,
      importance: #HIGH,
      label: 'Object'
    }
  ]
  ObjectName;

  @UI.lineItem: [
    {
      position: 20,
      label: 'Object Type'
    }
  ]
  ObjectType;

  @UI.lineItem: [
    {
      position: 30,
      label: 'Operation'
    }
  ]
  Operation;

  @UI.lineItem: [
    {
      position: 40,
      label: 'Containing Routine'
    }
  ]
  ContainingRoutine;

  @UI.lineItem: [
    {
      position: 50,
      label: 'Dynamic Access'
    }
  ]
  DynamicAccess;

  @UI.lineItem: [
    {
      position: 60,
      label: 'Read Only'
    }
  ]
  ReadOnly;

  @UI.lineItem: [
    {
      position: 70,
      label: 'Paging'
    }
  ]
  PagingCapability;

  @UI.lineItem: [
    {
      position: 80,
      label: 'Confidence'
    }
  ]
  Confidence;
}